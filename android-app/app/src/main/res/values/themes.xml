<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        VirtualMind splash/launch theme.
        Dark base → window is black (#0A0A0A = BackgroundPrimary) before
        Compose draws, preventing any white flash on cold start.
        Edge-to-edge is enforced in MainActivity via enableEdgeToEdge().
    -->
    <style name="Theme.VirtualMind" parent="android:Theme.Material.NoActionBar">
        <!-- Window background = BackgroundPrimary Obsidian -->
        <item name="android:windowBackground">@color/background_primary</item>
        <!-- Status bar: transparent (drawn by edge-to-edge in code) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Navigation bar: transparent -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Light status-bar icons: false → white icons on dark bg -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>