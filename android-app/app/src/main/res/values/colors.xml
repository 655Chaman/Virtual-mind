<?xml version="1.0" encoding="utf-8"?>
<!--
    VirtualMind XML color resources.
    These mirror the tokens in Color.kt so the XML layer (themes, splash)
    uses the same palette as the Compose layer.
-->
<resources>
    <!-- Backgrounds -->
    <color name="background_primary">#0A0A0A</color>   <!-- BackgroundPrimary / Obsidian -->
    <color name="background_deep">#060606</color>       <!-- BackgroundDeep (WebView bg) -->
    <color name="background_card">#141414</color>       <!-- BackgroundCard / Surface -->
    <color name="background_elevated">#222222</color>   <!-- BackgroundElevated / Surface2 -->

    <!-- Parrot Green brand -->
    <color name="parrot_green">#00A86B</color>          <!-- Primary brand green -->
    <color name="parrot_green_light">#5DDBAA</color>    <!-- Light green (dark theme) -->
    <color name="parrot_green_dark">#007A4D</color>     <!-- Dark green (pressed/container) -->

    <!-- Accent gold -->
    <color name="accent_gold">#C9A84C</color>
    <color name="accent_gold_dim">#8C7435</color>
    <color name="accent_gold_bright">#FFDF7D</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B0B0B0</color>
    <color name="text_dim">#888888</color>
    <color name="text_on_green">#CCFFEB</color>
    <color name="text_on_light">#0D1F18</color>

    <!-- Status -->
    <color name="status_error">#EF4444</color>
    <color name="status_warning">#F59E0B</color>
    <color name="status_success">#22C55E</color>
    <color name="status_info">#3B82F6</color>

    <!-- Notification badges -->
    <color name="badge_prayer">#10B981</color>
    <color name="badge_alarm">#F97316</color>
</resources>
