{
    "name": "Workflow C: Apify Enrichment",
    "nodes": [
        {
            "parameters": {},
            "id": "manual-trigger",
            "name": "When clicking \"Execute Workflow\"",
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "resource": "dataset",
                "operation": "getAll",
                "datasetId": "uob1b2h7HpGRqlHgG",
                "returnAll": true
            },
            "id": "apify",
            "name": "Apify: Get Data",
            "type": "n8n-nodes-base.apify",
            "typeVersion": 1,
            "position": [
                450,
                300
            ],
            "credentials": {
                "apifyApi": {
                    "id": "YOUR_APIFY_CREDENTIAL_ID",
                    "name": "Apify account"
                }
            }
        },
        {
            "parameters": {
                "url": "https://api.exa.ai/search",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "accept",
                            "value": "application/json"
                        },
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_EXA_API_KEY"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n    \"query\": \"{{ $json.company.name }} founder\",\n    \"type\": \"auto\",\n    \"category\": \"linkedin profile\",\n    \"numResults\": 1\n}"
            },
            "id": "exa",
            "name": "Exa: Enrich Decision-Maker",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "model": "claude-3-5-sonnet-20240620",
                "options": {
                    "temperature": 1,
                    "maxTokens": 850
                }
            },
            "id": "anthropic-model",
            "name": "Anthropic Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
            "typeVersion": 1,
            "position": [
                850,
                500
            ],
            "credentials": {
                "anthropicApi": {
                    "id": "YOUR_ANTHROPIC_CREDENTIAL_ID",
                    "name": "Anthropic account"
                }
            }
        },
        {
            "parameters": {
                "prompt": "=Retrieve this person's full name from {{ $json.results[0].title }} and their LinkedIn URL {{ $json.results[0].url }}. Output the result only in the correct JSON with no spaces{\"result\":\"\"}",
                "messages": {}
            },
            "id": "anthropic-chain",
            "name": "Get Full Name",
            "type": "@n8n/n8n-nodes-langchain.chainLlm",
            "typeVersion": 1.4,
            "position": [
                850,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const jsonString = $input.item.json.text;\ntry {\n  const parsed = JSON.parse(jsonString);\n  return { json: { result: parsed.result } };\n} catch (e) {\n  return { json: { result: jsonString, error: 'Failed to parse JSON' } };\n}"
            },
            "id": "parse-json",
            "name": "Parse JSON",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://api.findymail.com/v1/find",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_FINDYMAIL_API_KEY"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"name\": \"{{ $json.result }}\",\n  \"domain\": \"{{ $('Apify: Get Data').item.json.company.url }}\"\n}"
            },
            "id": "findymail",
            "name": "Findymail: Find Email",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1250,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.contact.email }}",
                            "operation": "notEmpty"
                        }
                    ]
                }
            },
            "id": "filter-email",
            "name": "Email Found?",
            "type": "n8n-nodes-base.filter",
            "typeVersion": 1,
            "position": [
                1450,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://hook.us1.make.com/boif5gz47wdqwejrtz1ntwvj23ud4gla",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n\"email\":\"{{ $json.contact.email }}\",\n\"fullName\":\"{{ $('Parse JSON').item.json.result }}\",\n\"jobTitle\":\"{{ $('Apify: Get Data').item.json.job_title }}\",\n\"companyName\":\"{{ $('Apify: Get Data').item.json.company.name }}\",\n\"datePosted\":\"{{ $('Apify: Get Data').item.json.job_listing_posted }}\"\n}"
            },
            "id": "webhook-callback",
            "name": "Send Data To Callback",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1650,
                300
            ]
        }
    ],
