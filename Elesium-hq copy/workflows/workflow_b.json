{
    "name": "Workflow B: Email & Opportunity Generator",
    "nodes": [
        {
            "parameters": {},
            "id": "manual-trigger",
            "name": "When clicking \"Execute Workflow\"",
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "name",
                            "name": "Name",
                            "value": "John Doe",
                            "type": "string"
                        },
                        {
                            "id": "company",
                            "name": "Company",
                            "value": "Acme Corp",
                            "type": "string"
                        },
                        {
                            "id": "website",
                            "name": "Website",
                            "value": "https://example.com",
                            "type": "string"
                        },
                        {
                            "id": "linkedin",
                            "name": "LinkedIn",
                            "value": "https://linkedin.com/in/johndoe",
                            "type": "string"
                        }
                    ]
                }
            },
            "id": "mock-data",
            "name": "Mock Lead Data",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $json.Website }}",
                "options": {}
            },
            "id": "http-request",
            "name": "Fetch Website",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "options": {}
            },
            "id": "html-to-text",
            "name": "Convert HTML to Text",
            "type": "n8n-nodes-base.htmlToMarkdown",
            "typeVersion": 1,
            "position": [
                850,
                300
            ]
        },
        {
            "parameters": {
                "model": "gpt-4o",
                "options": {
                    "temperature": 0.7
                }
            },
            "id": "openai-model",
            "name": "OpenAI Chat Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
            "typeVersion": 1,
            "position": [
                1050,
                500
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI account"
                }
            }
        },
        {
            "parameters": {
                "prompt": "=You are an expert SDR. Analyze the following company website text and identifying opportunities (hiring, expansion, new products). Then, draft a high-quality cold email to {{ $('Mock Lead Data').item.json.Name }} at {{ $('Mock Lead Data').item.json.Company }}.\n\nWebsite Content:\n{{ $json.data }}\n\nKey Requirements:\n- Keep it under 150 words.\n- Focus on their needs, not just our services.\n- Use a professional but conversational tone.\n\nEmail Draft:",
                "messages": {}
            },
            "id": "llm-chain",
            "name": "Generate Email",
            "type": "@n8n/n8n-nodes-langchain.chainLlm",
            "typeVersion": 1.4,
            "position": [
                1050,
                300
            ]
        },
        {
            "parameters": {
                "operation": "append",
                "documentId": {
                    "__rl": true,
                    "mode": "url",
                    "value": "YOUR_GOOGLE_SHEET_URL"
                },
                "sheetName": {
                    "__rl": true,
                    "mode": "list",
                    "value": "Sheet1"
                },
                "columns": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "Name": "={{ $('Mock Lead Data').item.json.Name }}",
                        "Company": "={{ $('Mock Lead Data').item.json.Company }}",
                        "Email Draft": "={{ $json.text }}"
                    }
                }
            },
            "id": "google-sheets",
            "name": "Save to Sheets",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                1350,
                300
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
                    "name": "Google Sheets account"
                }
            }
        }
    ],
    "connections": {
        "When clicking \"Execute Workflow\"": {
            "main": [
                [
                    {
                        "node": "Mock Lead Data",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Mock Lead Data": {
            "main": [
                [
                    {
                        "node": "Fetch Website",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Website": {
            "main": [
                [
                    {
                        "node": "Convert HTML to Text",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Convert HTML to Text": {
            "main": [
                [
                    {
                        "node": "Generate Email",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "OpenAI Chat Model": {
            "ai_language_model": [
                [
                    {
                        "node": "Generate Email",
                        "type": "ai_language_model",
                        "index": 0
                    }
                ]
            ]
        },
        "Generate Email": {
            "main": [
                [
                    {
                        "node": "Save to Sheets",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}