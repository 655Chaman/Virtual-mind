{
    "name": "AI Inbox Manager & Lead Assistant",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutesInterval": 15
                        }
                    ]
                }
            },
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "resource": "message",
                "operation": "getAll",
                "returnAll": true,
                "filters": {
                    "labelIds": [
                        "INBOX"
                    ],
                    "q": "is:unread"
                },
                "options": {
                    "rawAsBinary": false
                }
            },
            "name": "Gmail: Get Unread",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2,
            "position": [
                450,
                300
            ],
            "credentials": {
                "gmailOAuth2": {
                    "id": "YOUR_GMAIL_CREDENTIAL_ID",
                    "name": "Gmail Account"
                }
            }
        },
        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const email = $input.item.json;\nconst body = email.snippet || email.body || '';\nconst from = email.from || '';\nconst subject = email.subject || '';\n\nreturn {\n  json: {\n    email_id: email.id,\n    thread_id: email.threadId,\n    from: from,\n    subject: subject,\n    body_preview: body.substring(0, 1000)\n  }\n};"
            },
            "name": "Prepare Data",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "resource": "chat",
                "model": "gpt-4o",
                "messages": {
                    "values": [
                        {
                            "role": "system",
                            "content": "You manage Chaman's inbox. Classify this email into ONE category:\n\n1. 'Action Required': Needs a response, decision, or manual task (alerts, client emails, questions).\n2. 'Waiting On': Updates on pending items (replies to sent emails).\n3. 'Reference': Newsletters, notifications, FYIs, receipts, promos.\n4. 'Lead Reply': Direct response to an outbound sales campaign (from a prospect).\n\nOutput only the category name."
                        },
                        {
                            "content": "From: {{ $json.from }}\nSubject: {{ $json.subject }}\nBody Snippet: {{ $json.body_preview }}"
                        }
                    ]
                },
                "options": {
                    "temperature": 0
                }
            },
            "name": "AI Classifier",
            "type": "n8n-nodes-base.openAi",
            "typeVersion": 1,
            "position": [
                850,
                300
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI Account"
                }
            }
        },
        {
            "parameters": {
                "dataType": "string",
                "value1": "={{ $json.message.content }}",
                "rules": {
                    "rules": [
                        {
                            "value2": "Lead Reply"
                        },
                        {
                            "value2": "Action Required"
                        },
                        {
                            "value2": "Waiting On"
                        },
                        {
                            "value2": "Reference"
                        }
                    ]
                }
            },
            "name": "Route by Type",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 1,
            "position": [
                1050,
                300
            ]
        },
        {
            "parameters": {
                "resource": "chat",
                "model": "gpt-4o",
                "messages": {
                    "values": [
                        {
                            "role": "system",
                            "content": "Classify this LEAD REPLY into one intent:\n- INTERESTED (wants to book/learn more)\n- OBJECTION (timing/price/need)\n- INFO_REQUEST (case studies/details)\n- WRONG_PERSON (referral)\n- NOT_NOW (bad timing)\n- UNSUBSCRIBE\n\nOutput only the intent."
                        },
                        {
                            "content": "Email Body: {{ $('Prepare Data').item.json.body_preview }}"
                        }
                    ]
                },
                "options": {
                    "temperature": 0
                }
            },
            "name": "Analyze Lead Intent",
            "type": "n8n-nodes-base.openAi",
            "typeVersion": 1,
            "position": [
                1250,
                100
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI Account"
                }
            }
        },
        {
            "parameters": {
                "resource": "chat",
                "model": "gpt-4o",
                "messages": {
                    "values": [
                        {
                            "role": "system",
                            "content": "Draft a short, casual reply to this lead based on their intent ({{ $json.message.content }}).\nSign off as 'Chaman'.\nKeep it under 3 sentences."
                        },
                        {
                            "content": "Prosect's email: {{ $('Prepare Data').item.json.body_preview }}"
                        }
                    ]
                },
                "options": {
                    "temperature": 0.7
                }
            },
            "name": "Draft Reply",
            "type": "n8n-nodes-base.openAi",
            "typeVersion": 1,
            "position": [
                1450,
                100
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI Account"
                }
            }
        },
        {
            "parameters": {
                "channel": "messaging",
                "text": "🚨 New Lead Reply",
                "blocksUi": {
                    "blocksValues": [
                        {
                            "type": "section",
                            "text": {
                                "text": "*From:* {{ $('Prepare Data').item.json.from }}\n*Intent:* {{ $('Analyze Lead Intent').item.json.message.content }}\n*Draft:* {{ $json.message.content }}",
                                "type": "mrkdwn"
                            }
                        },
                        {
                            "type": "actions",
                            "elements": {
                                "elementsValues": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "text": "Approve Draft",
                                            "type": "plain_text"
                                        },
                                        "actionId": "approve_draft",
                                        "value": "approve"
                                    },
                                    {
                                        "type": "button",
                                        "text": {
                                            "text": "Ignore",
                                            "type": "plain_text"
                                        },
                                        "actionId": "ignore_reply",
                                        "value": "ignore"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            "name": "Slack: Lead Alert",
            "type": "n8n-nodes-base.slack",
            "typeVersion": 2,
            "position": [
                1650,
                100
            ],
            "credentials": {
                "slackApi": {
                    "id": "YOUR_SLACK_CREDENTIAL_ID",
                    "name": "Slack Account"
                }
            }
        },
        {
            "parameters": {
                "channel": "general",
                "text": "⚠️ Action Required: {{ $('Prepare Data').item.json.subject }}\nFrom: {{ $('Prepare Data').item.json.from }}"
            },
            "name": "Slack: Action Alert",
            "type": "n8n-nodes-base.slack",
            "typeVersion": 2,
            "position": [
                1250,
                300
            ],
            "credentials": {
                "slackApi": {
                    "id": "YOUR_SLACK_CREDENTIAL_ID",
                    "name": "Slack Account"
                }
            }
        },
        {
            "parameters": {
                "operation": "addLabels",
                "messageId": "={{ $('Prepare Data').item.json.email_id }}",
                "labelIds": [
                    "Action Required"
                ]
            },
            "name": "Label: Action Required",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2,
            "position": [
                1450,
                300
            ],
            "credentials": {
                "gmailOAuth2": {
                    "id": "YOUR_GMAIL_CREDENTIAL_ID",
                    "name": "Gmail Account"
                }
            }
        },
        {
            "parameters": {
                "operation": "addLabels",
                "messageId": "={{ $('Prepare Data').item.json.email_id }}",
                "labelIds": [
                    "Waiting On"
                ]
            },
            "name": "Label: Waiting On",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2,
            "position": [
                1250,
                500
            ],
            "credentials": {
                "gmailOAuth2": {
                    "id": "YOUR_GMAIL_CREDENTIAL_ID",
                    "name": "Gmail Account"
                }
            }
        },
        {
            "parameters": {
                "operation": "addLabels",
                "messageId": "={{ $('Prepare Data').item.json.email_id }}",
                "labelIds": [
                    "Reference"
                ]
            },
            "name": "Label: Reference",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2,
            "position": [
                1250,
                700
            ],
            "credentials": {
                "gmailOAuth2": {
                    "id": "YOUR_GMAIL_CREDENTIAL_ID",
                    "name": "Gmail Account"
                }
            }
        },
        {
            "parameters": {
                "operation": "removeLabels",
                "messageId": "={{ $('Prepare Data').item.json.email_id }}",
                "labelIds": [
                    "UNREAD"
                ]
            },
            "name": "Mark Read (Archive)",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2,
            "position": [
                1450,
                700
            ],
            "credentials": {
                "gmailOAuth2": {
                    "id": "YOUR_GMAIL_CREDENTIAL_ID",
                    "name": "Gmail Account"
                }
            }
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "Gmail: Get Unread",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gmail: Get Unread": {
            "main": [
                [
                    {
                        "node": "Prepare Data",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Prepare Data": {
            "main": [
                [
                    {
                        "node": "AI Classifier",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "AI Classifier": {
            "main": [
                [
                    {
                        "node": "Route by Type",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Route by Type": {
            "main": [
                [
                    {
                        "node": "Analyze Lead Intent",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Slack: Action Alert",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Label: Waiting On",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Label: Reference",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Analyze Lead Intent": {
            "main": [
                [
                    {
                        "node": "Draft Reply",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Draft Reply": {
            "main": [
                [
                    {
                        "node": "Slack: Lead Alert",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Slack: Action Alert": {
            "main": [
                [
                    {
                        "node": "Label: Action Required",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Label: Reference": {
            "main": [
                [
                    {
                        "node": "Mark Read (Archive)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}